<?xml version="1.0" encoding="ISO8859-1"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="DESADVS">
		<!--  -->
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="DESADV" minOccurs="1" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="DESADV">
		<!--  -->
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ENTETE" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="GR_CPS" minOccurs="1" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ENTETE">
		<!--  -->
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="HGEN" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HDDT" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HREF" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HNBY" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HNSU" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HNDP" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HNSF" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSH" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNIV" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HTDT" minOccurs="0" maxOccurs="1"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="HGEN">
		<!-- Informations générales de l'avis d'expédition -->
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="HGEN_ID" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HGEN_TYPE_VERSION" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HGEN_CODE_EMETTEUR" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HGEN_CODE_DESTINATAIRE" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HGEN_DEMANDE_ACC" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_INDICATEUR_TEST" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_TYPE_MESSAGE_EDI" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HGEN_VERSION_MESSAGE_EDI" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HGEN_NUMERO_EDITION_EDI" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HGEN_AGENCE_CONTROLE_EDI" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HGEN_CODE_ASSOCIATION_EDI" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HGEN_TYPE_MESSAGE" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HGEN_NUMERO_MESSAGE" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HGEN_FONCTION_MESSAGE" minOccurs="1" maxOccurs="1"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="HGEN_ID" type="xs:string"/>
	<!-- Identifiant enregistrement. Constante "HGEN". -->
	<xs:element name="HGEN_TYPE_VERSION" type="xs:string"/>
	<!-- Type/version interface -->
	<xs:element name="HGEN_CODE_EMETTEUR" type="xs:string"/>
	<!-- Edifact : code émetteur de l'interchange -->
	<xs:element name="HGEN_CODE_DESTINATAIRE" type="xs:string"/>
	<!-- Edifact : code destinataire de l'interchange -->
	<xs:element name="HGEN_DEMANDE_ACC" type="xs:string"/>
	<!-- Edifact  : demande d'accusé de réception syntaxique (CONTRL) -->
	<xs:element name="HGEN_INDICATEUR_TEST" type="xs:string"/>
	<!-- Indicateur de test ('1'=Test sinon vide) -->
	<xs:element name="HGEN_TYPE_MESSAGE_EDI" type="xs:string"/>
	<!-- Edifact : type de message -->
	<xs:element name="HGEN_VERSION_MESSAGE_EDI" type="xs:string"/>
	<!-- Edifact : version de message -->
	<xs:element name="HGEN_NUMERO_EDITION_EDI" type="xs:string"/>
	<!-- Edifact : édition du message -->
	<xs:element name="HGEN_AGENCE_CONTROLE_EDI" type="xs:string"/>
	<!-- Edifact : agence de contrôle -->
	<xs:element name="HGEN_CODE_ASSOCIATION_EDI" type="xs:string"/>
	<!-- Edifact  : code association -->
	<xs:element name="HGEN_TYPE_MESSAGE" type="xs:string"/>
	<!-- Type d'avis d'expédition -->
	<xs:element name="HGEN_NUMERO_MESSAGE" type="xs:string"/>
	<!-- Numéro d'avis d'expédition unique attribué par l'émetteur du document -->
	<xs:element name="HGEN_FONCTION_MESSAGE" type="xs:string"/>
	<!-- Edifact  : code indiquant la fonction du message (Original, copie, annulation, ...) -->
	<xs:element name="HDDT">
		<!-- Dates de l'avis d'expédition -->
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="HDDT_ID" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HDDT_DATE_HEURE_EMISSION" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HDDT_DATE_HEURE_LIVRAISON_DEMANDEE" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HDDT_DATE_HEURE_LIVRAISON_PLUS_TOT" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HDDT_DATE_HEURE_LIVRAISON_PLUS_TARD" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HDDT_DATE_HEURE_ENLEVEMENT" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HDDT_DATE_HEURE_MISE_DISPOSITION" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HDDT_DATE_HEURE_EXPEDITION" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HDDT_DATE_HEURE_ESTIMEE_LIVRAISON" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HDDT_DATE_HEURE_SYSTEME" minOccurs="0" maxOccurs="1"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="HDDT_ID" type="xs:string"/>
	<!-- Identifiant enregistrement. Constante "HDDT". -->
	<xs:element name="HDDT_DATE_HEURE_EMISSION" type="xs:string"/>
	<!-- Date/Heure d'émission de l'avis d'expédition -->
	<xs:element name="HDDT_DATE_HEURE_LIVRAISON_DEMANDEE" type="xs:string"/>
	<!-- Date/Heure de livraison demandée -->
	<xs:element name="HDDT_DATE_HEURE_LIVRAISON_PLUS_TOT" type="xs:string"/>
	<!-- Date/heure de livraison au plus tôt -->
	<xs:element name="HDDT_DATE_HEURE_LIVRAISON_PLUS_TARD" type="xs:string"/>
	<!-- Date/heure de livraison au plus tard -->
	<xs:element name="HDDT_DATE_HEURE_ENLEVEMENT" type="xs:string"/>
	<!-- Date/Heure d'enlèvement -->
	<xs:element name="HDDT_DATE_HEURE_MISE_DISPOSITION" type="xs:string"/>
	<!-- Date/Heure de mise à disposition -->
	<xs:element name="HDDT_DATE_HEURE_EXPEDITION" type="xs:string"/>
	<!-- Date/Heure d'expédition -->
	<xs:element name="HDDT_DATE_HEURE_ESTIMEE_LIVRAISON" type="xs:string"/>
	<!-- Date/Heure estimée de livraison -->
	<xs:element name="HDDT_DATE_HEURE_SYSTEME" type="xs:string"/>
	<!-- Date/Heure Système (Date/Heure de l'avis d'expédition) - Date générée par le système à la création du BL. Non saisie par le fournisseur. -->
	<xs:element name="HREF">
		<!-- Références de l'avis d'expédition -->
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="HREF_ID" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HREF_NO_COMMANDE_REF" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HREF_DATE_HEURE_COMMANDE_REF" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HREF_NO_BON_LIVRAISON" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HREF_DATE_HEURE_BON_LIVRAISON" minOccurs="0" maxOccurs="1"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="HREF_ID" type="xs:string"/>
	<!-- Identifiant enregistrement. Constante "HREF". -->
	<xs:element name="HREF_NO_COMMANDE_REF" type="xs:string"/>
	<!-- Numéro de commande en référence. Obligatoire si la livraison fait référence à une seule commande sinon les numéros de commande seront indiqués sur chaque ligne -->
	<xs:element name="HREF_DATE_HEURE_COMMANDE_REF" type="xs:string"/>
	<!-- Date de la commande en référence. Obligatoire si la livraison fait référence à une seule commande sinon les numéros de commande seront indiqués sur chaque ligne
Provient de la date/Heure d'émission de la commande (dans le système du Distributeur) -->
	<xs:element name="HREF_NO_BON_LIVRAISON" type="xs:string"/>
	<!-- Numéro de bon de livraison -->
	<xs:element name="HREF_DATE_HEURE_BON_LIVRAISON" type="xs:string"/>
	<!-- Date/heure du bon de livraison.
Correspond à la date/heure de génération de l'avis d'expédition dans le système du Fournisseur -->
	<xs:element name="HNBY">
		<!-- Informations acheteur -->
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="HNBY_ID" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HNBY_CODE_ACHETEUR" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HNBY_TABLE_CODE_ACHETEUR" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HNBY_RAISON_SOCIALE_1_ACHETEUR" minOccurs="0" maxOccurs="1"/>
