	<!-- Raison sociale du fournisseur (4/5) -->
	<xs:element name="HNSU_RS_5_FOURNISSEUR" type="xs:string"/>
	<!-- Raison sociale du fournisseur (5/5) -->
	<xs:element name="HNSU_ADR_1_FOURNISSEUR" type="xs:string"/>
