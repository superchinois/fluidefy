	<!-- Adresse du fournisseur (2/4) -->
	<xs:element name="HNSU_ADR_3_FOURNISSEUR" type="xs:string"/>
	<!-- Adresse du fournisseur (3/4) -->
	<xs:element name="HNSU_ADR_4_FOURNISSEUR" type="xs:string"/>
	<!-- Adresse du fournisseur (4/4) -->
	<xs:element name="HNSU_VILLE_FOURNISSEUR" type="xs:string"/>
	<!-- Ville du fournisseur -->
	<xs:element name="HNSU_ETAT_REGION_FOURNISSEUR" type="xs:string"/>
	<!-- Etat/Région du fournisseur -->
	<xs:element name="HNSU_CP_FOURNISSEUR" type="xs:string"/>
	<!-- Code postal du fournisseur -->
	<xs:element name="HNSU_PAYS_FOURNISSEUR" type="xs:string"/>
	<!-- Code pays du fournisseur (ISO 3166) -->
	<xs:element name="HNSU_CODE_INTERNE_FOURNISSEUR" type="xs:string"/>
	<!-- Numéro de client interne -->
	<xs:element name="HNDP">
