	<!-- Adresse du lieu de livraison (3/4) -->
	<xs:element name="HNDP_ADR_4_LIVRAISON" type="xs:string"/>
	<!-- Adresse du lieu de livraison (4/4) -->
	<xs:element name="HNDP_VILLE_LIVRAISON" type="xs:string"/>
	<!-- Ville du lieu de livraison -->
	<xs:element name="HNDP_ETAT_REGION_LIVRAISON" type="xs:string"/>
	<!-- Etat/Région du lieu de livraison -->
	<xs:element name="HNDP_CODE_POSTAL_LIVRAISON" type="xs:string"/>
	<!-- Code postal du lieu de livraison -->
	<xs:element name="HNDP_PAYS_LIVRAISON" type="xs:string"/>
	<!-- Code pays du lieu de livraison (ISO 3166) -->
	<xs:element name="HNDP_CODE_INTERNE_LIVRAISON" type="xs:string"/>
	<!-- Numéro de client interne -->
	<xs:element name="HNSF">
