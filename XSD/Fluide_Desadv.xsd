				<xs:element ref="HNDP_CODE_POSTAL_LIVRAISON" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNDP_PAYS_LIVRAISON" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNDP_CODE_INTERNE_LIVRAISON" minOccurs="0" maxOccurs="1"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="HNDP_ID" type="xs:string"/>
	<!-- Identifiant enregistrement. Constante "HNDP". -->
	<xs:element name="HNDP_CODE_LIEU_LIVRAISON" type="xs:string"/>
