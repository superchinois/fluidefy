	<xs:element name="HNBY_RAISON_SOCIALE_2_ACHETEUR" type="xs:string"/>
	<!-- Raison sociale de l'acheteur (2/5) -->
	<xs:element name="HNBY_RAISON_SOCIALE_3_ACHETEUR" type="xs:string"/>
	<!-- Raison sociale de l'acheteur (3/5) -->
	<xs:element name="HNBY_RAISON_SOCIALE_4_ACHETEUR" type="xs:string"/>
	<!-- Raison sociale de l'acheteur (4/5) -->
	<xs:element name="HNBY_RAISON_SOCIALE_5_ACHETEUR" type="xs:string"/>
	<!-- Raison sociale de l'acheteur (5/5) -->
	<xs:element name="HNBY_ADRESSE_1_ACHETEUR" type="xs:string"/>
	<!-- Adresse de l'acheteur (1/4) -->
	<xs:element name="HNBY_ADRESSE_2_ACHETEUR" type="xs:string"/>
	<!-- Adresse de l'acheteur (2/4) -->
	<xs:element name="HNBY_ADRESSE_3_ACHETEUR" type="xs:string"/>
	<!-- Adresse de l'acheteur (3/4) -->
	<xs:element name="HNBY_ADRESSE_4_ACHETEUR" type="xs:string"/>
	<!-- Adresse de l'acheteur (4/4) -->
	<xs:element name="HNBY_VILLE_ACHETEUR" type="xs:string"/>
	<!-- Ville de l'acheteur -->
	<xs:element name="HNBY_ETAT_REGION_ACHETEUR" type="xs:string"/>
	<!-- Etat/Région de l'acheteur -->
	<xs:element name="HNBY_CODE_POSTAL_ACHETEUR" type="xs:string"/>
	<!-- Code postal de l'acheteur -->
	<xs:element name="HNBY_PAYS_ACHETEUR" type="xs:string"/>
	<!-- Code pays de l'acheteur (ISO 3166) -->
	<xs:element name="HNBY_CODE_INTERNE_ACHETEUR" type="xs:string"/>
	<!-- Numéro de client interne -->
	<xs:element name="HNSU">
		<!-- Informations fournisseur (vendeur) -->
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="HNSU_ID" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HNSU_CODE_FOURNISSEUR" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HNSU_TABLE_CODE_FOURNISSEUR" minOccurs="1" maxOccurs="1"/>
