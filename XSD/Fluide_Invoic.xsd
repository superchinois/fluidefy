<?xml version="1.0" encoding="ISO8859-1"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="INVOICS">
		<!--  -->
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="INVOIC" minOccurs="1" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="INVOIC">
		<!--  -->
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ENTETE" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="LIGNES" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="PIED" minOccurs="0" maxOccurs="1"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--  -->
	<xs:element name="ENTETE">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="HGEN" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HDDT" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HFTX" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="HREF" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HNBY" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HNSE" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HNDP" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HNSF" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNCO" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNIV" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HNRE" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HNLC" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNDL" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HPAI" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HALC" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--  -->
	<xs:element name="HGEN">
		<!-- Informations générales du document -->
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="HGEN_ID" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HGEN_TYPE_VERSION" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_CODE_EMETTEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_TABLE_CODE_EMETTEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_CODE_DESTINATAIRE" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_TABLE_CODE_DESTINATAIRE" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_ICR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_DEMANDE_ACC" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_INDICATEUR_TEST" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_TYPE_MESSAGE_EDI" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_VERSION_MESSAGE_EDI" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_NUMERO_EDITION_EDI" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_AGENCE_CONTROLE_EDI" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_CODE_ASSOCIATION_EDI" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_TYPE_MESSAGE" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_NOM_DOCUMENT" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_NUMERO_MESSAGE" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_FONCTION_MESSAGE" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_TYPE_REPONSE" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_STATUT_FACTURE" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HGEN_COMMENTAIRE_ANNULATION" minOccurs="0" maxOccurs="1"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--  -->
	<xs:element name="HGEN_ID" type="xs:string"/>
	<!-- Identifiant enregistrement. Constante "HGEN". -->
	<xs:element name="HGEN_TYPE_VERSION" type="xs:string"/>
	<!-- Type/version interface -->
	<xs:element name="HGEN_CODE_EMETTEUR" type="xs:string"/>
	<!-- Edifact : code émetteur de l'interchange (GLN recommandé) -->
	<xs:element name="HGEN_TABLE_CODE_EMETTEUR" type="xs:string"/>
	<!-- Edifact : type code émetteur de l'interchange -->
	<xs:element name="HGEN_CODE_DESTINATAIRE" type="xs:string"/>
	<!-- Edifact : code destinataire de l'interchange (GLN recommandé) -->
	<xs:element name="HGEN_TABLE_CODE_DESTINATAIRE" type="xs:string"/>
	<!-- Edifact : type code destinataire de l'interchange -->
	<xs:element name="HGEN_ICR" type="xs:string"/>
	<!-- Edifact : référence unique interchange -->
	<xs:element name="HGEN_DEMANDE_ACC" type="xs:string"/>
	<!-- Edifact : demande d'accusé de réception syntaxique (CONTRL) -->
	<xs:element name="HGEN_INDICATEUR_TEST" type="xs:string"/>
	<!-- Indicateur de test ('1' = test sinon vide) -->
	<xs:element name="HGEN_TYPE_MESSAGE_EDI" type="xs:string"/>
	<!-- Edifact : Type de message -->
	<xs:element name="HGEN_VERSION_MESSAGE_EDI" type="xs:string"/>
	<!-- Edifact : Version de message -->
	<xs:element name="HGEN_NUMERO_EDITION_EDI" type="xs:string"/>
	<!-- Edifact : Edition du message -->
	<xs:element name="HGEN_AGENCE_CONTROLE_EDI" type="xs:string"/>
	<!-- Edifact : Agence de contrôle -->
	<xs:element name="HGEN_CODE_ASSOCIATION_EDI" type="xs:string"/>
	<!-- Edifact : Code association -->
	<xs:element name="HGEN_TYPE_MESSAGE" type="xs:string"/>
	<!-- Edifact : Type de document -->
	<xs:element name="HGEN_NOM_DOCUMENT" type="xs:string"/>
	<!-- Edifact : 'V02P01' ou 'V03P01' (* Dématérialisation) -->
	<xs:element name="HGEN_NUMERO_MESSAGE" type="xs:string"/>
	<!-- Numéro de document unique attribué par l'émetteur du document -->
	<xs:element name="HGEN_FONCTION_MESSAGE" type="xs:string"/>
	<!-- Edifact : code indiquant la fonction du message (Original, duplicata, ...) -->
	<xs:element name="HGEN_TYPE_REPONSE" type="xs:string"/>
	<!-- Edifact : code indiquant la demande d'un accusé de réception fonctionnel -->
	<xs:element name="HGEN_STATUT_FACTURE" type="xs:string"/>
	<!-- Statut de la facture -->
	<xs:element name="HGEN_COMMENTAIRE_ANNULATION" type="xs:string"/>
	<!-- Commentaire d'annulation -->
	<!--  -->
	<xs:element name="HDDT">
		<!-- Dates du document -->
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="HDDT_ID" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HDDT_DATE_HEURE_EMISSION" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HDDT_DATE_HEURE_ENLEVEMENT" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HDDT_DATE_HEURE_EXPEDITION" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HDDT_DATE_HEURE_REELLE_LIVRAISON" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HDDT_PERIODE_FACTURATION" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HDDT_DATE_HEURE_SYSTEME" minOccurs="0" maxOccurs="1"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--  -->
	<xs:element name="HDDT_ID" type="xs:string"/>
	<!-- Identifiant enregistrement. Constante "HDDT". -->
	<xs:element name="HDDT_DATE_HEURE_EMISSION" type="xs:string"/>
	<!-- Date/Heure d'émission du document -->
	<xs:element name="HDDT_DATE_HEURE_ENLEVEMENT" type="xs:string"/>
	<!-- Date/Heure d'enlèvement (si date de transfert de propriété) -->
	<xs:element name="HDDT_DATE_HEURE_EXPEDITION" type="xs:string"/>
	<!-- Date/Heure d'expédition (si date de transfert de propriété) -->
	<xs:element name="HDDT_DATE_HEURE_REELLE_LIVRAISON" type="xs:string"/>
	<!-- Date/Heure réelle de livraison (si date de transfert de propriété) -->
	<xs:element name="HDDT_PERIODE_FACTURATION" type="xs:string"/>
	<!-- Période de facturation (si facturation périodique) -->
	<xs:element name="HDDT_DATE_HEURE_SYSTEME" type="xs:string"/>
	<!-- Date/Heure Système - Date générée par le système à la création du fichier -->
	<!--  -->
	<xs:element name="HFTX">
		<!-- Commentaires s'appliquant à l'ensemble du document -->
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="HFTX_ID" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HFTX_NO_LIGNE" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HFTX_QUALIFIANT_COMMENTAIRE" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HFTX_COMMENTAIRE_1" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HFTX_COMMENTAIRE_2" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HFTX_COMMENTAIRE_3" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HFTX_COMMENTAIRE_4" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HFTX_COMMENTAIRE_5" minOccurs="0" maxOccurs="1"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--  -->
	<xs:element name="HFTX_ID" type="xs:string"/>
	<!-- Identifiant enregistrement. Constante "HFTX". -->
	<xs:element name="HFTX_NO_LIGNE" type="xs:string"/>
	<!-- Numéro séquentiel de ligne de commentaire -->
	<xs:element name="HFTX_QUALIFIANT_COMMENTAIRE" type="xs:string"/>
	<!-- Type de commentaire en code -->
	<xs:element name="HFTX_COMMENTAIRE_1" type="xs:string"/>
	<!-- Commentaire 1/5 -->
	<xs:element name="HFTX_COMMENTAIRE_2" type="xs:string"/>
	<!-- Commentaire 2/5 (* si nécessaire) -->
	<xs:element name="HFTX_COMMENTAIRE_3" type="xs:string"/>
	<!-- Commentaire 3/5 (* si nécessaire) -->
	<xs:element name="HFTX_COMMENTAIRE_4" type="xs:string"/>
	<!-- Commentaire 4/5 (* si nécessaire) -->
	<xs:element name="HFTX_COMMENTAIRE_5" type="xs:string"/>
	<!-- Commentaire 5/5 (* si nécessaire) -->
	<!--  -->
	<xs:element name="HREF">
		<!-- Références du document -->
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="HREF_ID" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HREF_NO_COMMANDE" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HREF_DATE_COMMANDE" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HREF_NO_BL" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HREF_DATE_BL" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HREF_NO_FACTURE" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HREF_DATE_FACTURE" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HREF_NO_CONTRAT" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HREF_DATE_CONTRAT" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HREF_NO_DESADV" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HREF_DATE_DESADV" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HREF_NO_TARIF" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HREF_DATE_TARIF" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HREF_NO_RECADV" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HREF_DATE_RECADV" minOccurs="0" maxOccurs="1"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--  -->
	<xs:element name="HREF_ID" type="xs:string"/>
	<!-- Identifiant enregistrement. Constante "HREF". -->
	<xs:element name="HREF_NO_COMMANDE" type="xs:string"/>
	<!-- Numéro de commande client -->
	<xs:element name="HREF_DATE_COMMANDE" type="xs:string"/>
	<!-- Date de commande client -->
	<xs:element name="HREF_NO_BL" type="xs:string"/>
	<!-- Numéro de bon de livraison -->
	<xs:element name="HREF_DATE_BL" type="xs:string"/>
	<!-- Date bon de livraison -->
	<xs:element name="HREF_NO_FACTURE" type="xs:string"/>
	<!-- Numéro de facture (* en cas d'avoir) -->
	<xs:element name="HREF_DATE_FACTURE" type="xs:string"/>
	<!-- Date de facture (* en cas d'avoir) -->
	<xs:element name="HREF_NO_CONTRAT" type="xs:string"/>
	<!-- Numéro de contrat -->
	<xs:element name="HREF_DATE_CONTRAT" type="xs:string"/>
	<!-- Date de contrat -->
	<xs:element name="HREF_NO_DESADV" type="xs:string"/>
	<!-- Numéro de message Desadv (avis d'expédition) -->
	<xs:element name="HREF_DATE_DESADV" type="xs:string"/>
	<!-- Date de message Desadv (avis d'expédition) -->
	<xs:element name="HREF_NO_TARIF" type="xs:string"/>
	<!-- Numéro de tarif -->
	<xs:element name="HREF_DATE_TARIF" type="xs:string"/>
	<!-- Date de tarif -->
	<xs:element name="HREF_NO_RECADV" type="xs:string"/>
	<!-- Numéro de message Recadv (avis de réception) -->
	<xs:element name="HREF_DATE_RECADV" type="xs:string"/>
	<!-- Date de message Recadv (avis de réception) -->
	<!--  -->
	<xs:element name="HNBY">
		<!-- Informations acheteur (commandé par) -->
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="HNBY_ID" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HNBY_CODE_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_TABLE_CODE_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_RAISON_SOCIALE_1_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_RAISON_SOCIALE_2_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_RAISON_SOCIALE_3_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_RAISON_SOCIALE_4_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_RAISON_SOCIALE_5_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_ADRESSE_1_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_ADRESSE_2_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_ADRESSE_3_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_ADRESSE_4_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_VILLE_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_ETAT_REGION_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_CODE_POSTAL_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_PAYS_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_CODE_INTERNE_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_NO_TVA_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_NO_REF_GOUV_ACHETEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNBY_NO_ENREG_SOC_ACHETEUR" minOccurs="0" maxOccurs="1"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--  -->
	<xs:element name="HNBY_ID" type="xs:string"/>
	<!-- Identifiant enregistrement. Constante "HNBY". -->
	<xs:element name="HNBY_CODE_ACHETEUR" type="xs:string"/>
	<!-- Identification de l'acheteur (GLN recommandé) -->
	<xs:element name="HNBY_TABLE_CODE_ACHETEUR" type="xs:string"/>
	<!-- Type de code identification de l'acheteur -->
	<xs:element name="HNBY_RAISON_SOCIALE_1_ACHETEUR" type="xs:string"/>
	<!-- Raison sociale de l'acheteur (1/5) -->
	<xs:element name="HNBY_RAISON_SOCIALE_2_ACHETEUR" type="xs:string"/>
	<!-- Raison sociale de l'acheteur (2/5) (* si nécessaire) -->
	<xs:element name="HNBY_RAISON_SOCIALE_3_ACHETEUR" type="xs:string"/>
	<!-- Raison sociale de l'acheteur (3/5) (* si nécessaire) -->
	<xs:element name="HNBY_RAISON_SOCIALE_4_ACHETEUR" type="xs:string"/>
	<!-- Raison sociale de l'acheteur (4/5) (* si nécessaire) -->
	<xs:element name="HNBY_RAISON_SOCIALE_5_ACHETEUR" type="xs:string"/>
	<!-- Raison sociale de l'acheteur (5/5) (* si nécessaire) -->
	<xs:element name="HNBY_ADRESSE_1_ACHETEUR" type="xs:string"/>
	<!-- Adresse de l'acheteur (1/4) -->
	<xs:element name="HNBY_ADRESSE_2_ACHETEUR" type="xs:string"/>
	<!-- Adresse de l'acheteur (2/4) (* si nécessaire) -->
	<xs:element name="HNBY_ADRESSE_3_ACHETEUR" type="xs:string"/>
	<!-- Adresse de l'acheteur (3/4) (* si nécessaire) -->
	<xs:element name="HNBY_ADRESSE_4_ACHETEUR" type="xs:string"/>
	<!-- Adresse de l'acheteur (4/4) (* si nécessaire) -->
	<xs:element name="HNBY_VILLE_ACHETEUR" type="xs:string"/>
	<!-- Ville de l'acheteur -->
	<xs:element name="HNBY_ETAT_REGION_ACHETEUR" type="xs:string"/>
	<!-- Etat/Région de l'acheteur -->
	<xs:element name="HNBY_CODE_POSTAL_ACHETEUR" type="xs:string"/>
	<!-- Code postal de l'acheteur -->
	<xs:element name="HNBY_PAYS_ACHETEUR" type="xs:string"/>
	<!-- Code pays de l'acheteur (ISO 3166) -->
	<xs:element name="HNBY_CODE_INTERNE_ACHETEUR" type="xs:string"/>
	<!-- Code interne acheteur -->
	<xs:element name="HNBY_NO_TVA_ACHETEUR" type="xs:string"/>
	<!-- Numéro d'identification TVA -->
	<xs:element name="HNBY_NO_REF_GOUV_ACHETEUR" type="xs:string"/>
	<!-- N° de référence gouvernementale (France : SIREN/SIRET) -->
	<xs:element name="HNBY_NO_ENREG_SOC_ACHETEUR" type="xs:string"/>
	<!-- N° d'enregistrement de la société (France : RCS/RCM) -->
	<!--  -->
	<xs:element name="HNSE">
		<!-- Informations vendeur (facturé par) -->
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="HNSE_ID" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="HNSE_CODE_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_TABLE_CODE_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_RS_1_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_RS_2_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_RS_3_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_RS_4_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_RS_5_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_ADR_1_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_ADR_2_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_ADR_3_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_ADR_4_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_VILLE_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_ETAT_REGION_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_CP_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_PAYS_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_CODE_INTERNE_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_NO_TVA_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_NO_REF_GOUV_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_NO_ENREG_SOC_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_FORME_JURIDIQUE_VENDEUR" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="HNSE_CAPITAL_SOCIAL_VENDEUR" minOccurs="0" maxOccurs="1"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!--  -->
	<xs:element name="HNSE_ID" type="xs:string"/>
	<!-- Identifiant enregistrement. Constante "HNSE". -->
	<xs:element name="HNSE_CODE_VENDEUR" type="xs:string"/>
	<!-- Identification du vendeur (GLN recommandé) (Facturé par) -->
	<xs:element name="HNSE_TABLE_CODE_VENDEUR" type="xs:string"/>
	<!-- Type de code identification du vendeur -->
	<xs:element name="HNSE_RS_1_VENDEUR" type="xs:string"/>
	<!-- Raison sociale du vendeur (1/5) -->
	<xs:element name="HNSE_RS_2_VENDEUR" type="xs:string"/>
	<!-- Raison sociale du vendeur (2/5) (* si nécessaire) -->
	<xs:element name="HNSE_RS_3_VENDEUR" type="xs:string"/>
	<!-- Raison sociale du vendeur (3/5) (* si nécessaire) -->
	<xs:element name="HNSE_RS_4_VENDEUR" type="xs:string"/>
	<!-- Raison sociale du vendeur (4/5) (* si nécessaire) -->
	<xs:element name="HNSE_RS_5_VENDEUR" type="xs:string"/>
	<!-- Raison sociale du vendeur (5/5) (* si nécessaire) -->
	<xs:element name="HNSE_ADR_1_VENDEUR" type="xs:string"/>
	<!-- Adresse du vendeur (1/4) -->
	<xs:element name="HNSE_ADR_2_VENDEUR" type="xs:string"/>
	<!-- Adresse du vendeur (2/4) (* si nécessaire) -->
	<xs:element name="HNSE_ADR_3_VENDEUR" type="xs:string"/>
	<!-- Adresse du vendeur (3/4) (* si nécessaire) -->
	<xs:element name="HNSE_ADR_4_VENDEUR" type="xs:string"/>
	<!-- Adresse du vendeur (4/4) (* si nécessaire) -->
	<xs:element name="HNSE_VILLE_VENDEUR" type="xs:string"/>
	<!-- Ville du vendeur -->
	<xs:element name="HNSE_ETAT_REGION_VENDEUR" type="xs:string"/>
	<!-- Etat/Région du vendeur -->
	<xs:element name="HNSE_CP_VENDEUR" type="xs:string"/>
	<!-- Code postal du vendeur -->
	<xs:element name="HNSE_PAYS_VENDEUR" type="xs:string"/>
	<!-- Code pays du vendeur (ISO 3166) -->
