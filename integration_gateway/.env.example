# Fluidefy Integration Gateway - environment variables
# Copy this file to `.env` and fill in real values.
# docker compose automatically reads `.env` for variable substitution.

# --- Infrastructure (managed by docker-compose; usually leave as-is) ---
DATABASE_URL=postgresql://fluidefy:fluidefy@postgres:5432/fluidefy_staging
REDIS_URL=redis://redis:6379/0

# --- Odoo ERP connection ---
ODOO_URL=http://localhost:8069
ODOO_DB=my_odoo_database
ODOO_USERNAME=admin
ODOO_APIKEY=your_odoo_password_or_api_key

# --- Odoo Sale Order ---
# Tag id used to flag sale orders created from Fluidefy (crm.tag)
ODOO_SO_TAGS_ID=0
# User id responsible for sale orders created from Fluidefy (res.users)
ODOO_SO_USER_ID=0
